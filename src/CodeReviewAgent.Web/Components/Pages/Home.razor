@page "/"
@rendermode InteractiveServer
@using CodeReviewAgent.Core.Llm
@inject KernelFactory KernelFactory

<PageTitle>代码审查 Agent</PageTitle>

<h1>代码审查 Agent</h1>

@* 缺 Key 时显式提示（真实状态，绝不伪造）。 *@
@if (!KernelFactory.Llm.IsConfigured)
{
    <p style="color:#a07070">
        未检测到 LLM ApiKey。请在 Web 项目目录下复制 appsettings.Local.json.example 为
        appsettings.Local.json 并填入 Llm:ApiKey，或设置环境变量 Llm__ApiKey 后重启。
    </p>
}
else
{
    <p>当前模型：@KernelFactory.Llm.ChatModel</p>
}


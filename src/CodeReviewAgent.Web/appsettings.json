{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Llm": {
    "Endpoint": "https://dashscope.aliyuncs.com/compatible-mode/v1",
    "ApiKey": "",
    "ChatModel": "glm-5.1",
    "Temperature": 0.2,
    "MaxTokens": 4096
  },
  "Embedding": {
    "Model": "text-embedding-v3"
  },
  "Rag": {
    "Enabled": true,
    "KnowledgeDirectory": "knowledge",
    "TopK": 4
  },
  "Agent": {
    "MaxSteps": 12,
    "Streaming": false
  },
  "ReviewAccess": {
    "AllowArbitraryDirectories": true,
    "SharedRoots": []
  },
  "ReviewWorkspace": {
    "UploadRoot": "App_Data/reviews",
    "MaxUploadBytes": 2097152,
    "MaxFilesPerUpload": 20
  }
}

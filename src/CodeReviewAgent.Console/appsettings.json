{
  "Logging": {
    "LogLevel": {
      "Default": "Warning"
    }
  },
  "Llm": {
    "Endpoint": "https://dashscope.aliyuncs.com/compatible-mode/v1",
    "ApiKey": "",
    "ChatModel": "glm-5.1",
    "Temperature": 0.2,
    "MaxTokens": 4096
  },
  "Embedding": {
    "Model": "text-embedding-v3"
  },
  "Rag": {
    "Enabled": true,
    "KnowledgeDirectory": "knowledge",
    "TopK": 4
  },
  "Agent": {
    "MaxSteps": 12,
    "_Streaming说明": "流式逐 token 输出。dashscope compatible-mode 支持流式 + 函数调用；个别端点若不兼容，循环会自动回退非流式。",
    "Streaming": true
  }
}
